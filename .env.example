# Server port
PORT=3001

# Root directory for user files
STORAGE_DIR=./data

# Directory for JSON configs (users, sessions)
CONFIG_DIR=./config

# Session lifetime in hours
SESSION_TTL_HOURS=24

# Maximum size of one file, in megabytes. Large files are uploaded in slices
# (see UPLOAD_CHUNK_MB), so this no longer has to stay small: 900 is fine for
# phone videos. Keep it within the disk quota you want to allow.
MAX_UPLOAD_MB=100

# Slice size for large uploads, in megabytes. Every slice is one short request,
# which is what keeps a 600 MB video alive through mobile networks, reverse
# proxies and Node's request timeout. 4-16 are sensible values.
UPLOAD_CHUNK_MB=8

# How long the server waits for progress on a connection before giving up, in
# milliseconds (0 = no limit). This drops sockets from phones that lost signal;
# it is NOT a total upload duration limit. Uploads are sliced (UPLOAD_CHUNK_MB),
# so a slow uplink is not cut off as long as bytes keep flowing.
REQUEST_TIMEOUT_MS=900000

# Environment mode
NODE_ENV=development

# libuv threadpool size. fs.stat, crypto, DNS all run here. Default is 4.
# On a low-spec host, raising this lets more file stats run in parallel
# (e.g. listing a large directory). Must be set BEFORE node starts — it is
# read once at startup, so it works here because server.js loads dotenv
# as its very first line. Try 8–16.
UV_THREADPOOL_SIZE=8
